# ─────────────────────────────────────────────────────────────────────────────
# Production env template — JouveERP
#
# Load these in Vercel → Project → Settings → Environment Variables (scope:
# Production; add Preview too if you want preview deploys to work). This file is
# a CHECKLIST — do NOT put real values here and do NOT commit secrets. For local
# development use `.env.local.example` instead (it targets the local Supabase
# stack). After loading the vars in Vercel, redeploy so the build picks them up.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project → Settings → API. SUPABASE_SERVICE_ROLE_KEY is secret (server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / Claude (required for the AI features) ───────────────────────────────
# console.anthropic.com → API keys. Powers chat, Document Intelligence, insights.
ANTHROPIC_API_KEY=

# ── AFIP (required to issue fiscal invoices) ─────────────────────────────────
# AFIP_ENV = "prod" in production ("homo" is the sandbox).
# Cert + key are base64-encoded PEM, single line: base64 -i cert.pem | tr -d '\n'
AFIP_ENV=prod
AFIP_CUIT=
AFIP_CERT=
AFIP_KEY=

# ── Inngest (required for crons / background jobs) ───────────────────────────
# app.inngest.com → Manage → Keys. Also register /api/inngest in Inngest Cloud
# so the scheduled functions (aging, expirations, vacations, BCRA FX, AI) run.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Email — Resend (required to email invoices / receipts) ───────────────────
# resend.com → API Keys. EMAIL_FROM must be a verified domain.
RESEND_API_KEY=
EMAIL_FROM="DZ & Sons <facturacion@tu-dominio.com>"
# EMAIL_REPLY_TO=facturacion@tu-dominio.com

# ── Public app URL (used for links in emails / push payloads) ────────────────
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# ── Sentry (optional — error reporting) ──────────────────────────────────────
# Same DSN value in both vars; the DSN is not secret. Leave blank to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Web Push (optional — push notifications with the app closed) ─────────────
# Generate the keys with: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:soporte@tu-dominio.com"
