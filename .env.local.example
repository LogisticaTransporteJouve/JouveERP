# Local Supabase (defaults from `supabase start`).
# Copy this file to `.env.local` to develop against the local stack.
# Do NOT commit `.env.local` — it is gitignored.
#
# The anon and service_role keys for local development are PUBLIC and
# identical for every Supabase install — copy them from the output of
# `pnpm dlx supabase status` after starting the local stack. They cannot
# be used against any production database, so they are intentionally
# not embedded here (SAST scanners flag any JWT-shaped string).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste-anon-key-from-supabase-status>
SUPABASE_SERVICE_ROLE_KEY=<paste-service-role-key-from-supabase-status>

# Supabase Postgres (only needed for direct DB tooling; server-only).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Logging
# LOG_LEVEL=debug
# DEBUG=true

# AFIP — homologación or producción.
# AFIP_ENV: "homo" (sandbox) or "prod".
# AFIP_CUIT: the 11-digit CUIT that owns the cert (no separators).
# AFIP_CERT / AFIP_KEY: base64-encoded PEM strings (single line). Generate with:
#   base64 -i cert.pem | tr -d '\n'
#   base64 -i key.pem  | tr -d '\n'
# Cert + key are issued by AFIP — see "Administrador de Relaciones de Clave Fiscal".
# AFIP_ENV=homo
# AFIP_CUIT=
# AFIP_CERT=
# AFIP_KEY=

# Inngest — leave blank in local development. The `inngest-cli dev` runtime
# bypasses signing/event-key checks when it talks to the local Next dev
# server. Both keys are required in production (Inngest Cloud).
# Get them from https://app.inngest.com/env/<env>/manage/keys
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Sentry — leave blank to disable error reporting (dev/local). Set both for
# production. The server-side DSN runs inside the Next runtime; the
# NEXT_PUBLIC_* one runs in the browser.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Playwright — credentials of the dev test user (created via
# `pnpm seed:dev`). Leave blank to use the documented defaults.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

# Playwright AFIP smoke (E.6.5) — set to "1" to enable
# tests/e2e/comprobantes-emit.spec.ts. Requires AFIP_ENV=homo + creds +
# a POS habilitado para jouve_fiscal + el runtime de Inngest local
# (pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest).
# RUN_AFIP_E2E=1
