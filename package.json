{
  "name": "jouve-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "dev:up": "supabase start && concurrently -k -n next,inngest -c cyan,magenta \"pnpm dev\" \"pnpm dev:inngest\"",
    "dev:inngest": "pnpm dlx inngest-cli@1.46.0 dev --no-discovery --host 127.0.0.1 -u http://127.0.0.1:3000/api/inngest",
    "preflight": "bash scripts/setup/doctor.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "manual:build": "vitest run features/guide/manual/build.test.ts --update",
    "manual:screenshots": "MANUAL_SCREENSHOTS=1 playwright test tests/e2e/manual-screenshots.spec.ts",
    "eval:ai": "AI_EVALS_LIVE=1 vitest run features/ai/evals/routing.live.test.ts features/ai/evals/answer-format.live.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:security": "RUN_SECURITY=1 vitest run tests/security",
    "test:scripts": "node --test scripts/*.test.mjs .github/scripts/*.test.mjs",
    "db:types:generate": "bash scripts/db-types.sh",
    "db:types:check": "bash scripts/db-types-check.sh",
    "check:migrations": "bash scripts/check-migrations.sh origin/main",
    "check:forbidden-words": "bash scripts/check-forbidden-words.sh",
    "seed:dev": "node scripts/seed-dev-user.mjs",
    "seed:all": "node scripts/seed-everything.mjs",
    "db:reset": "supabase db reset && node scripts/seed-everything.mjs",
    "db:load-prod": "bash scripts/load-prod-data-local.sh",
    "db:restamp": "bash scripts/dev/restamp-migrations.sh",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/react": "^4.0.166",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.25",
    "ai": "^7.0.162",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "inngest": "^4.26.2",
    "lucide-react": "^1.67.0",
    "marked": "^18.1.3",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "node-forge": "^1.4.2",
    "pdfjs-dist": "6.5.438",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-pdf": "^11.0.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inngest/test": "1.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "fflate": "0.8.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "squawk-cli": "2.70.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "ws@8": "8.20.1",
      "protobufjs@8": "8.2.0",
      "cjs-module-lexer@1": "2.2.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
